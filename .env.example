# =============================================================================
# QueryDesk — Environment Configuration
# Copy this file to .env and fill in values for your deployment.
# =============================================================================

# --- Core Application ---
ENVIRONMENT=development          # development | staging | production
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=info                   # debug | info | warning | error

# --- AI & NLP ---
GEMINI_API_KEY=your_gemini_api_key_here
INTENT_CONFIDENCE_THRESHOLD=0.75
RAG_SIMILARITY_THRESHOLD=0.70
SENTIMENT_ESCALATION_THRESHOLD=-0.5

# --- Database ---
DATABASE_PATH=backend/data/chatbot.db

# --- Security & Auth ---
JWT_SECRET=change-this-to-a-random-64-char-secret-in-production
SESSION_TTL_MINUTES=30

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=30
MAX_CONVERSATION_TURNS=50

# --- CRM Webhooks (Optional) ---
CRM_WEBHOOK_SECRET=your_webhook_hmac_secret_here
ZENDESK_API_TOKEN=
JIRA_API_TOKEN=
FRESHDESK_API_TOKEN=
